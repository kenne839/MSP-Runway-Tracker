# ==============================================================================
# KMSP Runway Tracker - Environment Configuration
# ==============================================================================
# Copy this file to '.env' in the project root to configure your OpenSky API
# credentials and polling interval.

# ------------------------------------------------------------------------------
# OpenSky Network API Authentication (Free Registered Account: 4,000 req/day)
# ------------------------------------------------------------------------------
# 1. Sign up for a free account at: https://opensky-network.org
# 2. Go to your Account page -> "API Clients" -> "Create API Client"
# 3. Enter your Client ID and Client Secret below (or place credentials.json in root):
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Alternatively, if you have a direct API token or username/password:
# OPENSKY_API_KEY=
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=

# ------------------------------------------------------------------------------
# Polling Interval (seconds)
# ------------------------------------------------------------------------------
# With a free registered account (4,000 queries/day):
# - 30.0s: 2,880 req/day (runs 24/7 with 1,120 queries headroom)
# - 25.0s: 3,456 req/day (runs 24/7 with 544 queries headroom)
# - 15.0s: 1,920 req / 8-hour workday (ideal for office use)
MSP_POLL_INTERVAL=30.0

# ------------------------------------------------------------------------------
# Data Source & Server Settings (Optional)
# ------------------------------------------------------------------------------
# MSP_DATA_SOURCE=opensky
# MSP_SERVER_PORT=8080
